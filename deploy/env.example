# Copy to deploy/.env and edit before `docker compose -f deploy/compose.prod.yml up`.
# Never commit a real .env file.

# Public hostnames served by Caddy (automatic HTTPS). May be identical.
API_DOMAIN=api.example.com
MCP_DOMAIN=mcp.example.com

# Optional image tag (default: latest). Prefer a release tag in production.
IMAGE_TAG=latest

# Mongo database name inside the mongo service.
DAD_JOKE_MONGODB_DATABASE=dadjoke

# Facts append-only retention (days). Valid 1..365; default 30.
# Also bounds how old a fact `ts` may be on ingest. Invalid values prevent startup.
DAD_JOKE_FACTS_RETENTION_DAYS=30

# Open registration. Prefer false in production; create users via
# `docker compose exec server /server create-user --email ...`.
ALLOW_SIGNUP=false
